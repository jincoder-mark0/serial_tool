/* ==================================================================================
   SerialTool Dark Theme
   ==================================================================================
   [Color Palette Reference]

   1. Backgrounds
      - BG Main:            #1e1e1e (Window Base, Inputs)
      - BG Panel/Alt:       #2b2b2b (Widget, Tab Selected)
      - BG Header/Bar:      #333333 (Header, Button Normal, StatusBar)
      - BG Disabled:        #252525

   2. Foregrounds (Text)
      - Text Main:          #e0e0e0
      - Text Dim/Hint:      #b0b0b0
      - Text Disabled:      #606060
      - Text Inverted:      #ffffff

   3. Borders & Separators
      - Border Main:        #404040
      - Border Light:       #505050
      - Border Focus:       #4CAF50 (Green Accent for Focus)

   4. Selections
      - Selection BG:       #264f78 (VS Code Blue)
      - Selection Text:     #ffffff

   5. Accents & States
      - Primary (Green):    #4CAF50 (Focus, Title, Active Tab Bottom)
      - Secondary (Blue):   #2196F3 (Checked State)
      - Danger (Red):       #F44336 (Error, Stop, Delete)
      - Warning (Yellow):   #FFC107 (Pause)

   6. Component Specific
      - Button Hover:       #454545
      - Button Pressed:     #2a2a2a
      - ScrollBar Handle:   #505050
      - SmartEdit LineNum:  #2b2b2b (BG), #808080 (Text), #2d2d2d (Current)
   ================================================================================== */

/* Global Settings */
QWidget {
    background-color: #2b2b2b;
    color: #e0e0e0;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QToolTip {
    background-color: #333333;
    color: #e0e0e0;
    border-color: #505050;
    border-radius: 4px;
}

/* MainWindow */
QMainWindow {
    background-color: #1e1e1e;
}

QMainWindow::separator {
    background-color: #404040;
}

QMainWindow::separator:hover {
    background-color: #505050;
}

/* QTabWidget */
QTabWidget::pane {
    border-color: #404040;
    background-color: #2b2b2b;
}

QTabBar::tab {
    background-color: #333333;
    color: #b0b0b0;
    border-color: #404040;
}

QTabBar::tab:selected {
    background-color: #2b2b2b;
    color: #ffffff;
    border-bottom-color: #4CAF50;
}

QTabBar::tab:hover {
    background-color: #3a3a3a;
    color: #e0e0e0;
}

QTabBar::close-button {
    image: url(resources/icons/dark/close_dark.svg);
    border-radius: 2px;
}

QTabBar::close-button:hover {
    background-color: #505050;
}

/* QPushButton */
QPushButton {
    background-color: #3a3a3a;
    border-color: #5f5f5f;
    color: #e0e0e0;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #454545;
    border-color: #606060;
}

QPushButton:pressed {
    background-color: #2a2a2a;
    border-color: #4CAF50;
}

QPushButton:checked {
    background-color: #264f78;
    border-color: #2196F3;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #252525;
    color: #606060;
    border-color: #303030;
}

/* Icons */
QPushButton#add_row_btn { qproperty-icon: url(resources/icons/dark/add_dark.svg); }
QPushButton#remove_row_btn { qproperty-icon: url(resources/icons/dark/delete_dark.svg); }
QPushButton#up_row_btn { qproperty-icon: url(resources/icons/dark/up_dark.svg); }
QPushButton#down_row_btn { qproperty-icon: url(resources/icons/dark/down_dark.svg); }
QPushButton#data_log_search_prev_btn { qproperty-icon: url(resources/icons/dark/find_prev_dark.svg); }
QPushButton#data_log_search_next_btn { qproperty-icon: url(resources/icons/dark/find_next_dark.svg); }

/* Inputs */
QLineEdit, QTextEdit, QPlainTextEdit, QSmartTextEdit, QSmartListView {
    background-color: #1e1e1e;
    border-color: #404040;
    color: #e0e0e0;
    selection-background-color: #264f78;
    selection-color: #ffffff;
    border-radius: 4px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSmartTextEdit:focus, QSmartListView:focus {
    border-color: #4CAF50;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QSmartTextEdit:disabled, QSmartListView:disabled {
    background-color: #252525;
    color: #606060;
}

/* QSmartTextEdit Properties */
QSmartTextEdit {
    qproperty-lineNumberBackgroundColor: #2b2b2b;
    qproperty-lineNumberColor: #808080;
    qproperty-currentLineColor: #2d2d2d;
}

/* QComboBox */
QComboBox {
    background-color: #1e1e1e;
    border-color: #404040;
    color: #e0e0e0;
    border-radius: 4px;
}

QComboBox:hover {
    background-color: #454545;
}

QComboBox:on {
    border-color: #4CAF50;
}

QComboBox::down-arrow {
    image: url(resources/icons/dark/arrow_down_dark.svg);
}

QComboBox QAbstractItemView {
    background-color: #3a3a3a;
    border-color: #505050;
    selection-background-color: #4CAF50;
    selection-color: #ffffff;
}

/* QProgressBar */
QProgressBar {
    background-color: #1e1e1e;
    border-color: #404040;
    color: #ffffff;
    border-radius: 4px;
}

QProgressBar::chunk {
    background-color: #4CAF50;
    border-radius: 3px;
}

/* QScrollBar */
QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #2b2b2b;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #505050;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #606060;
}

/* Views */
QTableView, QListView, QTreeWidget, QSmartListView {
    background-color: #1e1e1e;
    border-color: #404040;
    gridline-color: #303030;
    selection-background-color: #264f78;
    selection-color: #ffffff;
    color: #e0e0e0;
}

QHeaderView::section {
    background-color: #333333;
    color: #b0b0b0;
    border-right-color: #404040;
    border-bottom-color: #404040;
}

QTableCornerButton::section {
    background-color: #333333;
    border-color: #404040;
}

/* QCheckBox */
QCheckBox::indicator {
    border-color: #505050;
    background-color: #1e1e1e;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #4CAF50;
    border-color: #4CAF50;
}

QCheckBox::indicator:hover {
    border-color: #4CAF50;
}

/* QGroupBox */
/* border-color #404040->#808080 (S-035): 배경 #2b2b2b 대비 1.37:1 -> 3.59:1로 상향
   (계산: tasks/S-022 스크립트 패턴, 실측값은 S-035 태스크 보고 참고). */
QGroupBox {
    border-color: #808080;
    border-radius: 4px;
}

QGroupBox::title, QLabel[class="section-title"] {
    color: #4CAF50;
}

QLabel[class="hint-text"],
QLabel[class="about-version"],
QLabel[class="about-copyright"] {
    color: #b0b0b0;
}

QLabel[class="file-path-box"] {
    color: #b0b0b0;
    border-color: #404040;
    background-color: #1e1e1e;
    border-radius: 4px;
}

/* QStatusBar */
QStatusBar {
    background-color: #333333;
    color: #b0b0b0;
    border-top-color: #404040;
}

/* QMenu */
QMenuBar {
    background-color: #333333;
    color: #e0e0e0;
}
QMenuBar::item:selected {
    background-color: #404040;
}

QMenu {
    background-color: #2b2b2b;
    border-color: #404040;
}

QMenu::item:selected {
    background-color: #4CAF50;
    color: #ffffff;
}

/* QToolBar */
QToolBar {
    background-color: #333333;
    border-bottom-color: #404040;
}

QToolBar QToolButton {
    border-radius: 4px;
}

QToolBar QToolButton:hover {
    background-color: #454545;
}

QToolBar QToolButton:pressed {
    background-color: #2a2a2a;
}

/* ==================================================================================
   Custom Buttons & States (Accent, Danger, Warning, Connected)
   ================================================================================== */

/* Accent - Save, Start
   S-063: normal/pressed는 이미 기준 충족(5.13/7.87). hover(#388E3C)만 흰 글씨
   대비 미달(4.12)이라 배경을 더 낮춤(#256029, 7.54). disabled 글씨도 대비
   미달(2.26)이라 밝게 조정(#7fbf8a, 5.81). */
QPushButton[class="accent"] {
    background-color: #2E7D32;
    border-color: #4CAF50;
    color: #ffffff;
}

QPushButton[class="accent"]:hover {
    background-color: #256029;
    border-color: #66BB6A;
}

QPushButton[class="accent"]:pressed {
    background-color: #1B5E20;
}

QPushButton[class="accent"]:disabled {
    background-color: #1b3a20;
    border-color: #2e5030;
    color: #7fbf8a;
}

/* Danger - Stop, Delete
   S-063: normal/hover/pressed는 이미 기준 충족(5.62/4.98/6.57). disabled만
   미달(1.86)이라 글씨를 밝게 조정(#d99999, 6.13). */
QPushButton[class="danger"] {
    background-color: #C62828;
    border-color: #F44336;
    color: #ffffff;
}

QPushButton[class="danger"]:hover {
    background-color: #D32F2F;
    border-color: #EF5350;
}

QPushButton[class="danger"]:pressed {
    background-color: #B71C1C;
}

QPushButton[class="danger"]:disabled {
    background-color: #4a1b1b;
    border-color: #602525;
    color: #d99999;
}

/* Warning - Pause
   S-063: normal/hover/pressed는 이미 기준 충족(8.69/10.14/5.07). disabled만
   미달(1.87)이라 글씨를 밝게 조정(#e0be5c, 6.10). */
QPushButton[class="warning"] {
    background-color: #FFC107;
    border-color: #FFD740;
    color: #2b2b2b;
}

QPushButton[class="warning"]:hover {
    background-color: #FFD740;
    border-color: #FFEA00;
}

QPushButton[class="warning"]:pressed {
    background-color: #FF6F00;
}

QPushButton[class="warning"]:disabled {
    background-color: #4a3b00;
    border-color: #605000;
    color: #e0be5c;
}

/* Port States
   S-065: hover가 accent 수정 전 값(#388E3C)을 그대로 쓰고 있어 같은 대비 미달
   (#ffffff on #388E3C = 4.12 FAIL - tests/test_qss_contrast.py 실측)이었다. dark
   accent hover가 이미 검증한 값(#256029, 7.54 OK)을 그대로 재사용했다. normal은
   accent normal과 같은 배경(#2E7D32)이라 이미 기준(5.13) 충족. */
QPushButton[state="connected"] {
    background-color: #2E7D32;
    border-color: #4CAF50;
    color: #ffffff;
}

QPushButton[state="connected"]:hover {
    background-color: #256029;
    border-color: #66BB6A;
}

QPushButton[state="disconnected"] {
    background-color: #3a3a3a;
    border-color: #505050;
    color: #e0e0e0;
}

QPushButton[state="disconnected"]:hover {
    background-color: #454545;
    border-color: #606060;
}

QPushButton[state="error"] {
    background-color: #C62828;
    border-color: #F44336;
    color: #ffffff;
}

QPushButton[state="error"]:hover {
    background-color: #D32F2F;
    border-color: #EF5350;
}

/* Recording (REC) State */
QPushButton[state="recording"]:checked {
    background-color: #5a1d1d;
    color: #ff8a80;
}

/* Port Status Dot (StatusBar) */
QLabel[state="connected"] {
    color: #4CAF50;
    font-weight: bold;
}

QLabel[state="disconnected"] {
    color: #9E9E9E;
    font-weight: bold;
}

/* Danger Progress (Buffer Overflow / Transfer Failure) */
QProgressBar[state="danger"]::chunk {
    background-color: #C62828;
}

/* Disabled States */
QComboBox:disabled {
    background-color: #252525;
    color: #606060;
    border-color: #303030;
}

QCheckBox::indicator:disabled {
    background-color: #252525;
    border-color: #303030;
}

QTabBar::tab:disabled {
    background-color: #252525;
    color: #606060;
}