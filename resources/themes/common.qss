/* Common Styles (Layout, Spacing, Fonts, Shapes) */
/* 모든 테마의 베이스 스타일입니다. 구조적인 정의만 포함합니다. */

/* Global Settings */
QWidget {
    outline: none; /* Focus dotted line 제거 */
}

/* QMainWindow Separator */
QMainWindow::separator {
    width: 2px;
    height: 2px;
}

/* QToolTip */
QToolTip {
    border-width: 1px;
    border-style: solid;
    border-radius: 4px;
    padding: 4px;
    opacity: 230;
}

/* QTabWidget */
QTabWidget::pane {
    border-width: 1px;
    border-style: solid;
}

QTabBar::tab {
    padding: 8px 16px;
    border-width: 1px;
    border-style: solid;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    border-bottom-width: 2px;
    border-bottom-style: solid;
}

QTabBar::close-button {
    subcontrol-origin: padding;
    subcontrol-position: right;
    border-radius: 2px;
}

/* QPushButton */
QPushButton {
    border-radius: 4px;
    padding: 6px 12px;
    border-width: 1px;
    border-style: solid;
    font-weight: normal;
}

/* Custom Button Classes (Font Weight) */
QPushButton[class="accent"],
QPushButton[class="danger"],
QPushButton[class="warning"],
QPushButton[state="connected"],
QPushButton[state="error"] {
    font-weight: bold;
}

/* Inputs */
QLineEdit, QTextEdit, QPlainTextEdit, QSmartTextEdit, QSmartListView {
    border-radius: 4px;
    padding: 4px;
    border-width: 1px;
    border-style: solid;
}

/* 테마 로드 실패 시 안전 장치 (Fallback) */
QSmartTextEdit {
    qproperty-lineNumberBackgroundColor: #f0f0f0;
    qproperty-lineNumberColor: #808080;
    qproperty-currentLineColor: #e8e8e8;
}

/* QComboBox */
QComboBox {
    border-radius: 4px;
    padding: 4px 8px;
    min-width: 60px;
    border-width: 1px;
    border-style: solid;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 0px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

/* QProgressBar */
QProgressBar {
    border-width: 1px;
    border-style: solid;
    border-radius: 4px;
    text-align: center;
}

QProgressBar::chunk {
    border-radius: 3px;
}

/* QScrollBar (Vertical & Horizontal) */
QScrollBar:vertical {
    border: none;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    min-width: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Views (Table, List, Tree) */
QTableView, QListView, QTreeWidget, QSmartListView {
    border-width: 1px;
    border-style: solid;
}

QHeaderView::section {
    padding: 4px;
    border: none;
    border-right-width: 1px;
    border-right-style: solid;
    border-bottom-width: 1px;
    border-bottom-style: solid;
}

QTableCornerButton::section {
    border: none;
}

QSmartListView::item {
    padding: 2px;
}

/* QCheckBox */
QCheckBox {
    spacing: 5px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-width: 1px;
    border-style: solid;
    border-radius: 3px;
}

/* QGroupBox */
QGroupBox {
    border-width: 1px;
    border-style: solid;
    border-radius: 4px;
    margin-top: 1.5em;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    font-weight: bold;
}

/* Section Title (Unified with GroupBox Title) */
/* margin-bottom는 common/constants.py의 LAYOUT_SPACING_TITLE(8)과 값을 맞춘다 (S-035) —
   QGroupBox 타이틀 여백(~20px)과 10배 차이나던 것을 좁혀 제목-내용 간격을 통일. */
QLabel[class="section-title"] {
    font-weight: bold;
    padding: 0 5px;
    margin-bottom: 8px;
}

/* Hint / Muted Text (색은 테마별 QSS에서 지정) */
QLabel[class="hint-text"] {
    font-weight: normal;
}

/* About Dialog Text Hierarchy (크기만 공통 지정, 색은 테마별 QSS에서 지정) */
QLabel[class="about-title"] {
    font-size: 24px;
    font-weight: bold;
}

QLabel[class="about-version"] {
    font-size: 14px;
    font-weight: normal;
}

QLabel[class="about-copyright"] {
    font-size: 12px;
    font-weight: normal;
}

/* File Path Box (선택된 파일 경로 표시, 색은 테마별 QSS에서 지정) */
QLabel[class="file-path-box"] {
    padding: 5px;
    border-width: 1px;
    border-style: solid;
    border-radius: 4px;
}

/* QStatusBar */
QStatusBar {
    border-top-width: 1px;
    border-top-style: solid;
}

/* QMenu */
QMenu {
    border-width: 1px;
    border-style: solid;
}

QMenu::item {
    padding: 4px 24px 4px 12px;
}

/* QToolBar */
QToolBar {
    border-bottom-width: 1px;
    border-bottom-style: solid;
    spacing: 5px;
}

QToolBar QToolButton {
    border: none;
    border-radius: 4px;
    padding: 4px;
}

/* Fonts: 폰트 패밀리/크기는 여기서 선언하지 않는다 (S-036).
   유일한 원천은 ThemeManager._generate_font_stylesheet()의 동적 스타일시트다 -
   여기 있던 .proportional-font/.fixed-font 하드코딩(9pt 고정)이 QSS 특이도
   (type+class=2)로 동적 규칙(class 또는 type 단독=1)을 항상 이겨 설정 폰트가
   위젯에 반영되지 않는 회귀를 냈다 (실측: D2Coding/Courier New로 바꿔도 Consolas
   9pt 고정). 폰트 외 속성이 필요해지면 이 규칙을 부활시키지 말고 별도 선택자로 추가한다. */