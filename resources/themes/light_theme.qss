/* ==================================================================================
   SerialTool Light Theme
   ==================================================================================
   [Color Palette Reference]

   1. Backgrounds
      - BG Main:            #ffffff (Window, Input Base)
      - BG Panel/Alt:       #f5f5f5 (Widget, Tab Selected)
      - BG Header/Bar:      #e0e0e0 (Header, Button Normal)
      - BG Disabled:        #f0f0f0

   2. Foregrounds (Text)
      - Text Main:          #333333
      - Text Dim/Hint:      #505050
      - Text Disabled:      #a0a0a0
      - Text Inverted:      #000000

   3. Borders & Separators
      - Border Main:        #c0c0c0
      - Border Light:       #d0d0d0
      - Border Focus:       #2196F3

   4. Selections
      - Selection BG:       #a0c8f0
      - Selection Text:     #000000

   5. Accents & States
      - Primary (Blue):     #2196F3 (Focus, Active Tab, Links)
      - Success (Green):    #4CAF50 (Connect, Start)
      - Danger  (Red):      #F44336 (Error, Stop, Delete)
      - Warning (Orange):   #FFC107 (Pause, Warning)

   6. Component Specific
      - Hover Overlay:      Darken by ~10% (e.g., #d0d0d0 for buttons)
      - Pressed Overlay:    Darken by ~20% (e.g., #c0c0c0 for buttons)
      - SmartEdit LineNum:  #f0f0f0 (BG), #808080 (Text), #e8e8e8 (Current)
   ================================================================================== */

/* Global Settings */
QWidget {
    background-color: #f5f5f5;
    color: #333333;
    selection-background-color: #a0c8f0;
    selection-color: #000000;
}

QToolTip {
    background-color: #ffffff;
    color: #333333;
    border-color: #c0c0c0;
}

/* MainWindow */
QMainWindow {
    background-color: #ffffff;
}

QMainWindow::separator {
    background-color: #d0d0d0;
}

QMainWindow::separator:hover {
    background-color: #c0c0c0;
}

/* QTabWidget */
QTabWidget::pane {
    border-color: #d0d0d0;
    background-color: #f5f5f5;
}

QTabBar::tab {
    background-color: #e0e0e0;
    color: #505050;
    border-color: #d0d0d0;
}

QTabBar::tab:selected {
    background-color: #f5f5f5;
    color: #000000;
    border-bottom-color: #2196F3;
}

QTabBar::tab:hover {
    background-color: #d0d0d0;
    color: #333333;
}

QTabBar::close-button {
    image: url(resources/icons/light/close_light.svg);
}

QTabBar::close-button:hover {
    background-color: #c0c0c0;
}

/* QPushButton */
QPushButton {
    background-color: #e0e0e0;
    border-color: #c0c0c0;
    color: #333333;
}

QPushButton:hover {
    background-color: #d0d0d0;
    border-color: #b0b0b0;
}

QPushButton:pressed {
    background-color: #c0c0c0;
    color: #000000;
}

QPushButton:checked {
    background-color: #a0c8f0;
    border-color: #2196F3;
    color: #000000;
}

QPushButton:disabled {
    background-color: #f0f0f0;
    color: #a0a0a0;
    border-color: #e0e0e0;
}

/* Icons */
QPushButton#add_row_btn { qproperty-icon: url(resources/icons/light/add_light.svg); }
QPushButton#remove_row_btn { qproperty-icon: url(resources/icons/light/delete_light.svg); }
QPushButton#up_row_btn { qproperty-icon: url(resources/icons/light/up_light.svg); }
QPushButton#down_row_btn { qproperty-icon: url(resources/icons/light/down_light.svg); }
QPushButton#data_log_search_prev_btn { qproperty-icon: url(resources/icons/light/find_prev_light.svg); }
QPushButton#data_log_search_next_btn { qproperty-icon: url(resources/icons/light/find_next_light.svg); }

/* Inputs */
QLineEdit, QTextEdit, QPlainTextEdit, QSmartTextEdit, QSmartListView {
    background-color: #ffffff;
    border-color: #c0c0c0;
    color: #333333;
    selection-background-color: #a0c8f0;
    selection-color: #000000;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSmartTextEdit:focus, QSmartListView:focus {
    border-color: #2196F3;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QSmartTextEdit:disabled, QSmartListView:disabled {
    background-color: #f0f0f0;
    color: #a0a0a0;
}

/* QSmartTextEdit Properties */
QSmartTextEdit {
    qproperty-lineNumberBackgroundColor: #f0f0f0;
    qproperty-lineNumberColor: #808080;
    qproperty-currentLineColor: #e8e8e8;
}

/* QComboBox */
QComboBox {
    background-color: #ffffff;
    border-color: #c0c0c0;
    color: #333333;
}

QComboBox:hover {
    background-color: #f0f0f0;
}

QComboBox:on {
    border-color: #2196F3;
}

QComboBox::down-arrow {
    image: url(resources/icons/light/arrow_down_light.svg);
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border-color: #c0c0c0;
    selection-background-color: #a0c8f0;
    selection-color: #000000;
}

/* QProgressBar */
QProgressBar {
    background-color: #ffffff;
    border-color: #c0c0c0;
    color: #000000;
}

QProgressBar::chunk {
    background-color: #2196F3;
}

/* QScrollBar */
QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #f0f0f0;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}

/* Views */
QTableView, QListView, QTreeWidget, QSmartListView {
    background-color: #ffffff;
    border-color: #c0c0c0;
    gridline-color: #e0e0e0;
    selection-background-color: #a0c8f0;
    selection-color: #000000;
    color: #333333;
}

QHeaderView::section {
    background-color: #f0f0f0;
    color: #505050;
    border-right-color: #d0d0d0;
    border-bottom-color: #d0d0d0;
}

QTableCornerButton::section {
    background-color: #f0f0f0;
    border-color: #d0d0d0;
}

/* QCheckBox */
QCheckBox::indicator {
    border-color: #c0c0c0;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #2196F3;
    border-color: #2196F3;
}

QCheckBox::indicator:hover {
    border-color: #2196F3;
}

/* QGroupBox */
/* border-color #c0c0c0->#8a8a8a (S-035): 배경 #f5f5f5 대비 1.67:1 -> 3.17:1로 상향
   (계산: tasks/S-022 스크립트 패턴, 실측값은 S-035 태스크 보고 참고). */
QGroupBox {
    border-color: #8a8a8a;
}

QGroupBox::title, QLabel[class="section-title"] {
    color: #1565C0;
}

QLabel[class="hint-text"],
QLabel[class="about-version"],
QLabel[class="about-copyright"] {
    color: #505050;
}

QLabel[class="file-path-box"] {
    color: #505050;
    border-color: #c0c0c0;
    background-color: #ffffff;
}

/* QStatusBar */
QStatusBar {
    background-color: #f0f0f0;
    color: #505050;
    border-top-color: #d0d0d0;
}

/* QMenu */
QMenuBar {
    background-color: #f0f0f0;
    color: #333333;
}
QMenuBar::item:selected {
    background-color: #c0c0c0;
}

QMenu {
    background-color: #ffffff;
    border-color: #c0c0c0;
}

QMenu::item:selected {
    background-color: #a0c8f0;
    color: #000000;
}

/* QToolBar */
QToolBar {
    background-color: #f0f0f0;
    border-bottom-color: #d0d0d0;
}

QToolBar QToolButton:hover {
    background-color: #e0e0e0;
}

QToolBar QToolButton:pressed {
    background-color: #d0d0d0;
}

/* ==================================================================================
   Custom Buttons & States (Accent, Danger, Warning, Connected)
   ================================================================================== */

/* Accent - Save, Start
   S-063: 흰 글씨가 밝은 녹 배경(#4CAF50/#66BB6A)에서 대비 미달(2.78/2.36)이라
   어두운 글씨(#1b1b1b)로 전환. pressed는 배경을 #1B5E20으로 낮춰 흰 글씨 유지
   (어두운 배경엔 밝은 글씨가 자연스럽다 - dracula 사례와 동일 원칙). */
QPushButton[class="accent"] {
    background-color: #4CAF50;
    border-color: #388E3C;
    color: #1b1b1b;
}

QPushButton[class="accent"]:hover {
    background-color: #66BB6A;
    border-color: #2E7D32;
}

QPushButton[class="accent"]:pressed {
    background-color: #1B5E20;
    color: #ffffff;
}

QPushButton[class="accent"]:disabled {
    background-color: #A5D6A7;
    border-color: #81C784;
    color: #1b5e20;
}

/* Danger - Stop, Delete
   S-063: 흰 글씨 배경 대비가 미달(normal 3.68/hover 3.49)이라 배경을 한 단계씩
   낮춤(normal→#C62828, hover→#D32F2F, pressed→#B71C1C). 글씨는 흰색 유지. */
QPushButton[class="danger"] {
    background-color: #C62828;
    border-color: #D32F2F;
    color: #ffffff;
}

QPushButton[class="danger"]:hover {
    background-color: #D32F2F;
    border-color: #C62828;
}

QPushButton[class="danger"]:pressed {
    background-color: #B71C1C;
}

QPushButton[class="danger"]:disabled {
    background-color: #EF9A9A;
    border-color: #E57373;
    color: #7f0000;
}

/* Warning - Pause
   S-063: pressed 배경이 실수로 danger 톤(#B71C1C)이었던 것을 warning 계열 어두운
   주황(#FF6F00)으로 교정 - 어두운 글씨(#1b1b1b)로 대비 확보(6.17). disabled도
   글씨색 교체(1.22→9.77). normal/hover(#333333)는 이미 기준 충족이라 유지. */
QPushButton[class="warning"] {
    background-color: #FFC107;
    border-color: #FFD740;
    color: #333333;
}

QPushButton[class="warning"]:hover {
    background-color: #FFD740;
    border-color: #FFEA00;
}

QPushButton[class="warning"]:pressed {
    background-color: #FF6F00;
    color: #1b1b1b;
}

QPushButton[class="warning"]:disabled {
    background-color: #FFE082;
    border-color: #FFD54F;
    color: #1b1b1b;
}

/* Port States
   S-065: accent/danger와 같은 원색을 재사용해 같은 대비 문제를 가지고 있었다
   (connected #ffffff on #4CAF50 = 2.78 FAIL, hover 2.36 FAIL; error #ffffff on
   #F44336 = 3.68 FAIL, hover 3.49 FAIL - tests/test_qss_contrast.py 실측). S-063과
   같은 원칙으로 accent/danger가 이미 검증한 값을 그대로 재사용해 고쳤다
   (connected: 어두운 글씨 #1b1b1b, 6.20/7.28 OK; error: 배경을 danger 톤으로 낮추고
   흰 글씨 유지, 5.62/4.98 OK). */
QPushButton[state="connected"] {
    background-color: #4CAF50;
    border-color: #388E3C;
    color: #1b1b1b;
}

QPushButton[state="connected"]:hover {
    background-color: #66BB6A;
    border-color: #2E7D32;
}

QPushButton[state="disconnected"] {
    background-color: #e0e0e0;
    border-color: #c0c0c0;
    color: #333333;
}

QPushButton[state="disconnected"]:hover {
    background-color: #d0d0d0;
    border-color: #b0b0b0;
}

QPushButton[state="error"] {
    background-color: #C62828;
    border-color: #D32F2F;
    color: #ffffff;
}

QPushButton[state="error"]:hover {
    background-color: #D32F2F;
    border-color: #C62828;
}

/* Recording (REC) State */
QPushButton[state="recording"]:checked {
    background-color: #ffcdd2;
    color: #b71c1c;
}

/* Port Status Dot (StatusBar) */
QLabel[state="connected"] {
    color: #1b5e20;
    font-weight: bold;
}

QLabel[state="disconnected"] {
    color: #616161;
    font-weight: bold;
}

/* Danger Progress (Buffer Overflow / Transfer Failure) */
QProgressBar[state="danger"]::chunk {
    background-color: #F44336;
}

/* Disabled States */
QComboBox:disabled {
    background-color: #f0f0f0;
    color: #a0a0a0;
    border-color: #e0e0e0;
}

QCheckBox::indicator:disabled {
    background-color: #f0f0f0;
    border-color: #e0e0e0;
}

QTabBar::tab:disabled {
    background-color: #f0f0f0;
    color: #a0a0a0;
}